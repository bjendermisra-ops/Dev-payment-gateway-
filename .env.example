# AuraPay - Automated UPI Payment Gateway
# Environment Configuration Template

# Server Port
PORT=3000

# Merchant Details
PAYEE_NAME="Your Business Name"
UPI_ID="yourhandle@upi"
BUSINESS_NAME="Your Store Name"

# Gmail IMAP Auto-Verification Configuration
# Note: Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASS="your-16-char-app-password"

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/aurapay?retryWrites=true&w=majority"

# Appwrite Cloud Configuration (Optional - for Serverless Deployments)
APPWRITE_ENDPOINT="https://cloud.appwrite.io/v1"
APPWRITE_PROJECT_ID="your_appwrite_project_id"
APPWRITE_API_KEY="your_appwrite_api_key"

# SECURITY: Generate at least 32 random bytes for this signing key.
SESSION_SECRET="replace-with-long-random-secret"

# Live checkout stays disabled unless a trusted bank/PSP verifier is connected.
# Never enable live checkout on the Vercel serverless demo.
PAYMENT_VERIFICATION_ENABLED=false
ENABLE_SIMULATIONS=false

# Optional: merchant-owned digital delivery destination (never third-party demo data).
DIGITAL_DELIVERY_URL=""
DIGITAL_DOWNLOAD_URL=""

# Persistent VPS worker only; do not put Gmail App Passwords in Vercel demo onboarding.
# Use the original GMAIL_USER and GMAIL_APP_PASS template fields only with authorized accounts.

# Only a trusted bank/PSP verification service may know this signing secret.
# Live gateway remains disabled without MONGODB_URI and PAYMENT_VERIFICATION_ENABLED=true.
VERIFIER_WEBHOOK_SECRET=""
