{
  "projectId": "6afaeffd00086cd457f7",
  "projectName": "AuraPay Gateway",
  "functions": [
    {
      "$id": "payment-gateway",
      "name": "payment-gateway",
      "runtime": "node-22",
      "path": "functions/payment-gateway",
      "entrypoint": "src/main.js",
      "commands": "npm install",
      "ignore": [
        "node_modules",
        ".git"
      ],
      "execute": [
        "any"
      ],
      "events": [],
      "schedule": "",
      "timeout": 900,
      "variables": {
        "MONGODB_URI": "mongodb+srv://<username>:<password>@cluster.mongodb.net/aurapay?retryWrites=true&w=majority"
      }
    }
  ]
}
